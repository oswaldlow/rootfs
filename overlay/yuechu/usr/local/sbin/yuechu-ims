#!/usr/bin/python3
"""yuechu-ims: keep IMS (VoLTE) registered on both SIM slots of the MT6895 MD.

The MD runs the IMS stack itself but only registers once the AP has enabled
the IMS features and brought up the IMS PDN, which Android's telephony data
framework does and Linux never did.  Per slot this daemon:
  - writes IMS_SET_CONFIG (the MIPC form of AT+EIMSCFG): VoLTE, SMS over IMS
    and emergency IMS on, video and Wi-Fi calling off;
  - enables +CIREG reporting and, while the slot is on LTE/NR but IMS is not
    registered, requests the IMS PDN (DATA_ACT_CALL, APN "ims", type ims).
The PDN is owned by the MD and outlives this process.

An IMS PDN can get stuck: up, but the MD never registers on it again
(seen after many re-registrations in one day; re-requesting or tearing the
PDN down does not help).  After two PDN requests without registration the
slot is re-attached (AT+COPS=2/0, not during a call, at most every 15 min),
which resets its IMS state.  Re-attaching the data slot leaves the
ModemManager bearer stale, so its NetworkManager connection is re-activated.

After a CS fallback call the MD stays on GSM/EDGE.  Two polls on a GSM RAT
outside a call re-send the initial attach setup (AT+EIAAPN/EIAREG/EDALLOW),
which brings it back to LTE.

  yuechu-ims            run (systemd service)
  yuechu-ims status     print IMS registration per slot (uses ttyCMIPC5)
"""
import struct, subprocess, sys, time
sys.path.insert(0, "/usr/local/lib/yuechu")
import yuechu_mipc as mp

DEV = "/dev/ttyCMIPC4"
STATUS_DEV = "/dev/ttyCMIPC5"
SLOTS = (1, 2)
POLL = 30
# volte, vilte, vowifi, viwifi, sms, eims
IMSCFG = bytes([1, 0, 0, 0, 1, 1])
LTE_RATS = (7, 11, 12, 13)
GSM_RATS = (0, 1, 3)
PDN_TRIES_BEFORE_REATTACH = 2
REATTACH_INTERVAL = 900


def log(msg):
    print(msg, flush=True)


def ims_pdn_request(apn=b"ims"):
    desc = bytearray(672)
    desc[1] = len(apn)
    desc[4:4 + len(apn)] = apn
    desc[414] = 0xff
    t, u8, u32 = mp.tlv, mp.u8, mp.u32
    # Same TLV order as the stock RIL / mm_mtk_mipc_data_act_request(), with
    # APN type 2 (ims) and reuse flag 0 (set up a new PDN).
    return (t(0x8106, b"\0") + t(0x010f, u32(0)) + t(0x8107, b"\0") + t(0x0108, u8(127)) +
            t(0x0101, apn + b"\0") + t(0x0109, u32(0x7FFDFFFF)) + t(0x0102, u32(2)) +
            t(0x010a, u8(0)) + t(0x0103, u8(3)) + t(0x010c, u32(0)) + t(0x0104, u8(3)) +
            t(0x010d, bytes(desc)) + t(0x0105, u8(0)))


def cireg(m, ps):
    r = m.at(ps, "AT+CIREG?")
    # +CIREG: <n>,<reg_info>[,<ext_info>]
    try:
        f = r.split(":", 1)[1].split("\n")[0].split(",")
        return int(f[1]), int(f[2]) if len(f) > 2 else 0
    except (IndexError, ValueError):
        return None, None


def slot_state(m, ps):
    sim = m.req(mp.SIM_STATUS_REQ, ps)
    rat = m.req(mp.NW_GET_RAT_REQ, ps).get(0x0100, b"\xff")[0]
    return mp.result(sim) == 0, rat


def configure(m, ps):
    r = m.req(mp.IMS_SET_CONFIG_REQ, ps, mp.tlv(0x100, mp.u32(0)) + mp.tlv(0x102, IMSCFG))
    m.at(ps, "AT+CIREG=2")
    return mp.result(r)


def in_call(m, ps):
    return "+CLCC:" in m.at(ps, "AT+CLCC")


def data_slot():
    out = subprocess.run(["mmcli", "-m", "any", "-K"], capture_output=True, text=True).stdout
    for line in out.splitlines():
        if "modem.generic.primary-sim-slot" in line:
            try:
                return int(line.split(":", 1)[1])
            except ValueError:
                return 0
    return 0


def reconnect_data():
    out = subprocess.run(["nmcli", "-t", "-f", "NAME,TYPE", "c", "show", "--active"],
                         capture_output=True, text=True).stdout
    for line in out.splitlines():
        name, _, typ = line.rpartition(":")
        if typ == "gsm":
            subprocess.run(["nmcli", "c", "down", name], capture_output=True)
            r = subprocess.run(["nmcli", "c", "up", name], capture_output=True, text=True)
            log("re-activated %s: %s" % (name, (r.stdout or r.stderr).strip()))


def return_to_lte(m, ps):
    for cmd in ('AT+EIAAPN="",0', "AT+EIAREG=1", "AT+EDALLOW=1"):
        m.at(ps, cmd)


def reattach(m, ps):
    m.at(ps, "AT+COPS=2", timeout=60)
    time.sleep(5)
    m.at(ps, "AT+COPS=0", timeout=60)


def status():
    # The daemon holds DEV; status uses its own port.
    with mp.Mipc(STATUS_DEV) as m:
        for ps in SLOTS:
            ok, rat = slot_state(m, ps)
            reg, ext = cireg(m, ps)
            feats = [n for b, n in ((1, "voice"), (2, "video"), (4, "sms")) if (ext or 0) & b]
            print("slot %d  rat %s  IMS %s %s" % (ps, rat, "registered" if reg == 1 else "not registered",
                                                  "(" + ", ".join(feats) + ")" if reg == 1 else ""))


def run():
    configured = set()
    last_try = {}
    was = {}
    tries = {}
    last_reattach = {}
    on_gsm = {}
    while True:
        try:
            with mp.Mipc(DEV) as m:
                for ps in SLOTS:
                    present, rat = slot_state(m, ps)
                    if not present:
                        configured.discard(ps)
                        continue
                    if ps not in configured:
                        res = configure(m, ps)
                        log("slot %d: IMS config volte/sms/eims on (result %s)" % (ps, res))
                        configured.add(ps)
                    reg, ext = cireg(m, ps)
                    if reg != was.get(ps):
                        log("slot %d: IMS %s (ext %s, rat %s)" % (ps, "registered" if reg == 1 else "not registered", ext, rat))
                        was[ps] = reg
                    if reg == 1:
                        tries[ps] = 0
                        continue
                    if rat in GSM_RATS:
                        on_gsm[ps] = on_gsm.get(ps, 0) + 1
                        if on_gsm[ps] >= 2 and not in_call(m, ps):
                            log("slot %d: on GSM RAT %d outside a call, re-sending the LTE attach setup" % (ps, rat))
                            on_gsm[ps] = 0
                            return_to_lte(m, ps)
                            if ps == data_slot():
                                time.sleep(15)
                                reconnect_data()
                        continue
                    on_gsm[ps] = 0
                    if rat not in LTE_RATS:
                        continue
                    if time.time() - last_try.get(ps, 0) < 120:
                        continue
                    if (tries.get(ps, 0) >= PDN_TRIES_BEFORE_REATTACH and
                            time.time() - last_reattach.get(ps, 0) > REATTACH_INTERVAL and
                            not in_call(m, ps)):
                        log("slot %d: IMS PDN up but not registered after %d requests, re-attaching" %
                            (ps, tries[ps]))
                        last_reattach[ps] = time.time()
                        tries[ps] = 0
                        reattach(m, ps)
                        if ps == data_slot():
                            time.sleep(10)
                            reconnect_data()
                        last_try[ps] = 0
                        continue
                    last_try[ps] = time.time()
                    tries[ps] = tries.get(ps, 0) + 1
                    r = m.req(mp.DATA_ACT_CALL_REQ, ps, ims_pdn_request(), timeout=40)
                    log("slot %d: requested IMS PDN, result 0x%x call id %s" %
                        (ps, mp.result(r) or 0, r.get(0x0100, b"?").hex()))
        except OSError as e:
            log("MIPC error: %s" % e)
        time.sleep(POLL)


if __name__ == "__main__":
    if len(sys.argv) > 1 and sys.argv[1] == "status":
        status()
    elif len(sys.argv) == 1:
        run()
    else:
        sys.exit(__doc__)
