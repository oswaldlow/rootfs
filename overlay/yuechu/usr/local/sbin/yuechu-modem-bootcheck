#!/bin/sh
# yuechu: a power-on caused by plugging USB while the phone is off makes the
# bootloader skip the modem image.  The kernel then gets a CCCI tag without
# modem information, disables md1 for the whole boot, and no ccmni/ttyCMIPC
# device ever appears.  A warm reboot goes through the normal path, so do
# that once.  The 60 s wait leaves time to log in and stop this unit.
set -e
stamp=/var/lib/yuechu/usb-poweron-reboot

disabled=0
# No grep -q: it closes the pipe early and dmesg logs a write error.
if dmesg | grep "md1 env prepare abnormal, disable this modem" >/dev/null; then disabled=1; fi

if [ "$disabled" = 0 ]; then
	rm -f "$stamp"
	exit 0
fi

reason=$(tr ' ' '\n' < /proc/cmdline | sed -n 's/^aee_aed\.pureason=//p' | tail -n 1)
if [ "$reason" != usb ]; then
	echo "modem disabled by the kernel, power-up reason '$reason': not rebooting"
	exit 0
fi
if [ -e "$stamp" ]; then
	echo "modem still disabled after a reboot for the USB power-on: giving up"
	exit 0
fi

mkdir -p "${stamp%/*}"
: > "$stamp"
sync
echo "USB power-on left the modem disabled: rebooting once in 60 s"
sleep 60
systemctl --no-block reboot
