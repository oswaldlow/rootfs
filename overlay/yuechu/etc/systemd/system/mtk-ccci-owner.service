[Unit]
Description=MediaTek CCCI modem userspace owner (yuechu)
Requires=yuechu-modem-prep.service
After=yuechu-modem-prep.service
ConditionPathExists=/dev/ccci_monitor
ConditionPathExists=/usr/libexec/mtk-ccci/start_owner.py

[Service]
Type=simple
EnvironmentFile=/etc/default/mtk-ccci
ExecStart=/usr/bin/python3 /usr/libexec/mtk-ccci/start_owner.py
Restart=no
UMask=0077
RuntimeDirectory=mtk-ccci
RuntimeDirectoryMode=0700
StateDirectory=mtk-ccci
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
