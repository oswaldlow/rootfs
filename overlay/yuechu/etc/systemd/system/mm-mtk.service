[Unit]
Description=ModemManager (MT6895 mtk-soc plugin build)
Requires=mtk-ccci-owner.service
After=mtk-ccci-owner.service dbus.service
# The mtk-soc ModemManager build is installed by hand (docs: baseband bring-up).
ConditionPathExists=/opt/mm-mtk/sbin/ModemManager

[Service]
Type=dbus
BusName=org.freedesktop.ModemManager1
Environment=LD_LIBRARY_PATH=/opt/mm-mtk/lib/aarch64-linux-gnu
# bounded wait for MD READY (md1:4) before probing ports
ExecStartPre=/bin/sh -c 'for i in $(seq 1 90); do grep -q "^md1:4" /sys/kernel/ccci/boot && exit 0; sleep 1; done; echo "MD not ready"; exit 1'
ExecStart=/opt/mm-mtk/sbin/ModemManager --test-plugin-dir=/opt/mm-mtk/lib/aarch64-linux-gnu/ModemManager
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
Alias=dbus-org.freedesktop.ModemManager1.service
